# ═══════════════════════════════════════════════════════════════════════════════
# LocalDistill Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your API keys.
# Run `python setup.py` for interactive configuration.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── API Keys ──────────────────────────────────────────────────────────────────
# At least one key is needed for on-policy distillation (teacher model).
# OpenRouter is recommended - one key for all models.

# OpenRouter (recommended) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Model Configuration ───────────────────────────────────────────────────────
# These are set by setup.py but can be overridden here.
# Primary configuration is in config.yaml.

# Student model (the one being fine-tuned)
# Options:
#   unsloth/Llama-3.2-3B-Instruct     (3B, 6GB VRAM, fast)
#   unsloth/Qwen2.5-3B-Instruct       (3B, 6GB VRAM, fast)
#   unsloth/Phi-3.5-mini-instruct     (4B, 6GB VRAM, fast)
#   unsloth/Mistral-7B-Instruct-v0.3  (7B, 10GB VRAM, balanced)
#   unsloth/Llama-3.1-8B-Instruct     (8B, 12GB VRAM, balanced)
LOCALDISTILL_MODEL=unsloth/Llama-3.2-3B-Instruct

# ── Legacy (for compatibility with old scripts) ───────────────────────────────
# LOCALDISTILL_API_MODEL is deprecated - use config.yaml models.teacher instead
